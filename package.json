{
  "name": "lb-tool",
  "version": "1.7.0",
  "description": "LB",
  "main": "main.js",
  "scripts": {
    "prestart": "node build.js",
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "prebuild": "node build.js",
    "build": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.littlebit.lb-tool",
    "productName": "LB Editor",
    "files": [
      "main.js",
      "renderer.js",
      "lib/**/*",
      "monaco-loader.js",
      "highlight-worker.js",
      "analysis-worker.js",
      "io-worker.js",
      "index.html",
      "styles.css",
      "node_modules/nspell/**/*",
      "node_modules/is-buffer/**/*",
      "node_modules/monaco-editor/**/*",
      "node_modules/xlsx/**/*"
    ],
    "asarUnpack": [
      "highlight-worker.js",
      "analysis-worker.js",
      "io-worker.js",
      "compute-worker.js",
      "node_modules/nspell/**/*",
      "node_modules/is-buffer/**/*",
      "node_modules/monaco-editor/min/**"
    ],
    "extraResources": [
      {
        "from": "dicts",
        "to": "dicts"
      },
      {
        "from": "editor_glossary.json",
        "to": "editor_glossary.json"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "LB Editor.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "LB Editor-Setup.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "LB-mac.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "LB-linux.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "monaco-editor": "^0.55.1",
    "nspell": "^2.1.5",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
